# Copy this to .env and fill in real values for local development.
# On Railway, set these as service variables instead of committing a .env.

# Railway's Postgres plugin injects this automatically when attached to
# your service -- for local dev, point it at a local/dev Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/recovery_aware?schema=public"

# Any long random string. `openssl rand -hex 32` is a good way to generate one.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development

# Terra (aggregator for Garmin + other wearables -- see
# src/modules/integrations/terra). Leave TERRA_MODE=mock until you have
# real Terra credentials; the app will return a fake widget URL instead of
# calling Terra's API, so you can build/test the connect flow first.
TERRA_MODE=mock
TERRA_API_KEY=
TERRA_DEV_ID=
TERRA_WEBHOOK_SECRET=
TERRA_WIDGET_REDIRECT_URL=http://localhost:3000/integrations/garmin/callback
